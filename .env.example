# ============================================================
#  AgriHealthAI — backend environment variables (EXAMPLE)
#  Copy this file to `.env` and fill in real values.
#  NEVER commit real keys. NEVER place keys in front-end code.
#  If a key is missing, that feature runs in clearly-labelled DEMO MODE.
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Optional: Food vision / image analysis ---
# Any OpenAI-compatible vision endpoint works.
VISION_API_URL=https://api.openai.com/v1/chat/completions
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini

# --- Optional: Nutrition database ---
# Example: USDA FoodData Central
NUTRITION_API_URL=https://api.nal.usda.gov/fdc/v1/foods/search
NUTRITION_API_KEY=

# --- Optional: Agricultural reference data / agronomy advisory provider ---
AGRI_DATA_API_URL=
AGRI_DATA_API_KEY=
